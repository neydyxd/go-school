# Скопируй в .env и поправь. .env в git не коммитят.
PORT=8080
DATABASE_URL=postgres://diploma:diploma@localhost:55433/diploma?sslmode=disable
# Пусто: Redis не используется и не проверяется в /readyz
REDIS_URL=redis://localhost:56380/0
LOG_LEVEL=debug
GIN_MODE=debug
SHUTDOWN_TIMEOUT=10s
# Локально пауза не нужна; в compose и проде 5s, см. m10/l02
DRAIN_DELAY=0s
