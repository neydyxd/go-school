# Скопируй в .env и поправь. .env в git не коммитят.
PORT=8080
DATABASE_URL=postgres://goschool:goschool@localhost:55432/tasktracker?sslmode=disable
# Обязателен, не короче 32 байт. Сгенерируй: openssl rand -base64 48
# Пусто специально: без своего секрета сервис не стартует (fail fast).
JWT_SECRET=
ACCESS_TTL=15m
REFRESH_TTL=720h
LOG_LEVEL=info
GIN_MODE=release
SHUTDOWN_TIMEOUT=10s
